#
# Caucus hub, as a systemd *user* unit (no root, no sudo).
#
# The at-sign placeholders below are filled in by contrib/install-hub-service.sh.
# Installing by hand means substituting them yourself; the binary path must be
# absolute, since the unit does not inherit your interactive shell PATH.
#
[Unit]
Description=Caucus hub (supervised agent message hub)
Documentation=https://github.com/obeone/caucus-mcp
After=network.target

[Service]
Type=simple

# Optional, and optional on purpose: the leading `-` means the unit still
# starts when the file is absent. Holds CAUCUS_OPERATOR_TOKEN and friends,
# kept out of the unit file (and out of `ps`). Installer chmods it to 600.
EnvironmentFile=-@ENVFILE@

# --no-browser is not optional here: without it the hub tries to pop a browser
# on every start and on every automatic restart.
ExecStart=@BINARY@ --host @HOST@ --port @PORT@ --no-browser

# Restart on crash, but not on a clean exit: a restart wipes the hub's
# in-memory state, so every peer loses its token and must join again.
Restart=on-failure
RestartSec=10

StandardOutput=append:@LOGFILE@
StandardError=append:@LOGFILE@

# Modest hardening. Deliberately no ProtectHome: the hub's own JSONL disk log
# (CAUCUS_LOG_FILE) usually lives under $HOME, and a read-only home turns that
# into a silent write failure. ProtectSystem=strict leaves $HOME writable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
